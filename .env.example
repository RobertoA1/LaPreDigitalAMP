# Demo usa SQLite y datos sintéticos. Sin DEMO_MODE, usar SQL Server (2022 o superior).
DEMO_MODE=true
DB_DIALECT=sqlite
SQLITE_STORAGE=./data/demo.sqlite
DB_HOST=localhost
DB_PORT=1433                 # se ignora con DB_INSTANCE; con el puerto por defecto el controlador negocia el protocolo
# DB_AUTH=windows            # windows (msnodesqlv8 + ODBC, conexión de confianza) | sql (tedious con DB_USER/DB_PASSWORD)
# DB_INSTANCE=               # instancia con nombre (SERVIDORINSTANCIA)
# DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server   # solo DB_AUTH=windows
DB_NAME=LaPreDigitalAMP
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
# Agente de conversión Buyer → Lead: lectura (solo SELECT) del OLTP y del DataMart. Heredan DB_HOST/DB_PORT/DB_INSTANCE/DB_AUTH
# salvo que se definan OLTP_DB_HOST, OLTP_DB_PORT, OLTP_DB_INSTANCE, OLTP_DB_AUTH, OLTP_DB_USER, OLTP_DB_PASSWORD (y DATAMART_DB_*).
# OLTP_DB_NAME=LaPreDigitalOLTP
# DATAMART_DB_NAME=LaPreDigitalDatamart
# Secreto compartido del webhook POST /api/webhooks/inscripciones (cabecera x-amp-webhook-secret). Sin valor, responde 503.
# BUYER_WEBHOOK_SECRET=
SESSION_SECRET=change-this-long-random-secret
# En despliegues HTTPS, usar true. Para ejecución local HTTP, false.
SESSION_COOKIE_SECURE=false
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
ANTHROPIC_API_KEY=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
EVOLUTION_WEBHOOK_SECRET=
GMAIL_ACCESS_TOKEN=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
