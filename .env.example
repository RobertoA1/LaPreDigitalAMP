# Demo usa SQLite y datos sintéticos. Sin DEMO_MODE, usar SQL Server 2022.
DEMO_MODE=true
DB_DIALECT=sqlite
SQLITE_STORAGE=./data/demo.sqlite
DB_HOST=localhost
DB_PORT=1433
DB_NAME=LaPreDigitalAMP
DB_USER=sa
DB_PASSWORD=
DB_ENCRYPT=false
SESSION_SECRET=change-this-long-random-secret
# En despliegues HTTPS, usar true. Para ejecución local HTTP, false.
SESSION_COOKIE_SECURE=false
OPENAI_API_KEY=
